#: src/Modules/Amp/AdminSchema.php:103
msgid "Invalid AMP Google Tag Manager Container ID. Valid ID format: GTM-XXXXX. Use comma without additional space (,) to enter more than one ID."
msgstr "ID de contenedor de Google Tag Manager de AMP no válido. Formato de ID válido: GTM-XXXXX. Utiliza una coma sin espacio adicional (,) para introducir más de un ID."

#: src/Modules/Container/AdminSchema.php:340
msgid "Turning on this option will load your Google Tag Manager container as early as possible during page load. This can cause issues if you are using jQuery in your custom HTML tags that fire on 'Page View' events."
msgstr "Si activas esta opción, cargarás el contenedor de Google Tag Manager lo antes posible durante la carga de la página. Esto puede causar problemas si estás utilizando jQuery en las etiquetas HTML personalizadas que se disparan en los eventos de 'páginas vistas '."

#: src/Modules/Container/AdminSchema.php:339
msgid "Load GTM container as early as possible"
msgstr "Carga el contenedor GTM lo antes posible"

#: src/Modules/Amp/AdminSchema.php:78
msgid "Google Tag Manager 'AMP' Container ID"
msgstr "ID de contenedor de Google Tag Manager 'AMP'"

